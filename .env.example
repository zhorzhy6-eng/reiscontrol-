# Copy to .env in the repository root. Values below are for local development only.
POSTGRES_DB=reiscontrol
POSTGRES_USER=reiscontrol
POSTGRES_PASSWORD=reiscontrol_local
MINIO_ROOT_USER=reiscontrol_local
MINIO_ROOT_PASSWORD=reiscontrol_local_secret
MINIO_BUCKET=reiscontrol

# Host processes (API, workers and bot) use these local service addresses.
DATABASE_URL=postgresql+psycopg://reiscontrol:reiscontrol_local@127.0.0.1:5432/reiscontrol
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=reiscontrol
OBJECT_STORAGE_REGION=us-east-1
AWS_ACCESS_KEY_ID=reiscontrol_local
AWS_SECRET_ACCESS_KEY=reiscontrol_local_secret
JWT_SECRET=replace-with-a-random-local-secret-at-least-32-characters
TELEGRAM_BOT_TOKEN=replace-with-local-bot-token
TELEGRAM_DEV_BOT_TOKEN=replace-with-local-dev-bot-token
TELEGRAM_DEV_CHAT_ID=replace-with-chat-id
LOG_LEVEL=INFO
