{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DocumentSetPayloadV1",
  "type": "object",
  "required": ["documents"],
  "additionalProperties": false,
  "properties": {
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_code", "attachment_id"],
        "additionalProperties": false,
        "properties": {
          "document_code": { "type": "string", "minLength": 1 },
          "attachment_id": { "type": "string", "format": "uuid" }
        }
      }
    }
  }
}
