{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PhotoSetPayloadV1",
  "type": "object",
  "required": ["photos"],
  "additionalProperties": false,
  "properties": {
    "photos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_code", "attachment_id", "source"],
        "additionalProperties": false,
        "properties": {
          "step_code": { "type": "string", "minLength": 1 },
          "attachment_id": { "type": "string", "format": "uuid" },
          "source": { "type": "string", "enum": ["camera", "gallery"] }
        }
      }
    }
  }
}
